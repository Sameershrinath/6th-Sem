    "import numpy as np\n",
    "\n",
    "# Discrete Distribution (Binomial)\n",
    "binomial = np.random.binomial(n=10, p=0.5, size=8)\n",
    "\n",
    "# Continuous Distribution (Normal)\n",
    "normal = np.random.normal(loc=50, scale=5, size=8)\n",
    "\n",
    "print(\"Binomial Distribution:\", binomial)\n",
    "print(\"Normal Distribution:\", normal)"
